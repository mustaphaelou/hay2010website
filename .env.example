# HAY2010 — environment variables (names and safe example values only).
#
# Copy to `.env.local` for local work, or set them in Coolify for a deployment.
# NEVER put a real secret in this file, in the image or in a build arg: the
# repository is public and image layers are forever. Real values live in
# Coolify (runtime secrets) and GitHub Actions secrets/variables.
#
# Full table with scope and owner: docs/ops/runbook.md "Environment variables".

# ---------------------------------------------------------------------------
# Runtime — application
# ---------------------------------------------------------------------------

# "staging" makes every response non-indexable (X-Robots-Tag) and serves a
# disallow-all /robots.txt. Anything else, including unset, is production.
SITE_ENV=production

# Deployment kill switch for forms. Off by default, and P1 also has a code floor
# that keeps forms off even when this is "true" (lib/flags.ts). Staging keeps it
# false permanently; production only flips after the F-211 filing.
FORMS_ENABLED=false

# Public canonical site URL. BUILD-TIME value (baked into the image by the CI
# build arg): changing it requires a new image. Used by metadata (#32).
NEXT_PUBLIC_SERVER_URL=https://staging.hay2010.ma

# ---------------------------------------------------------------------------
# Runtime — database (Payload 3 lands in #29)
# ---------------------------------------------------------------------------

# Internal Coolify Postgres URL, never public. Absent in fixture mode; when set,
# /api/health runs `SELECT 1` and answers 503 if the database is unreachable.
DATABASE_URL=postgres://hay2010:CHANGE_ME@hay2010-postgres:5432/hay2010

# Payload 3 secret (cookie/session signing). 32 random bytes, base64.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Stable across deploys: Server Action encryption key. 32 random bytes, base64.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Bearer secret for the scheduled revalidation route (#32).
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Runtime — object storage (Cloudflare R2)
# ---------------------------------------------------------------------------

# Media bucket hay2010-media (public via https://media.hay2010.ma).
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=hay2010-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.hay2010.ma

# ---------------------------------------------------------------------------
# Runtime — SMTP (Payload transactional mail / later contact form)
# ---------------------------------------------------------------------------

SMTP_HOST=mail.hay2010.ma
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@hay2010.ma
SMTP_PASSWORD=
MAIL_FROM=no-reply@hay2010.ma
MAIL_TO_CONTACT=contact@hay2010.ma

# ---------------------------------------------------------------------------
# Runtime — Turnstile (keep unset while forms are disabled)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Image metadata — set by the Docker build (read-only observability)
# ---------------------------------------------------------------------------

# Commit sha of the release, reported by /api/health as "version".
APP_VERSION=dev
